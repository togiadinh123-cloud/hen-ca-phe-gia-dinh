# ==========================================
# HẸN CÀ PHÊ — ENVIRONMENT VARIABLES CONFIG
# ==========================================

# 1. Ứng dụng & Nhận diện
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hẹn cà phê với Gia Định"
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# 2. Supabase Client (An toàn trên browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Supabase Server (CHỈ DÙNG TRÊN SERVER - KHÔNG ĐƯA VÀO BUNDLE CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Google Maps Client API Key (Dùng cho Maps JavaScript API, giới hạn HTTP Referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key

# 5. Google Maps Server API Key (Dùng cho Places API New, Routes API - giới hạn IP Server)
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-api-key

# 6. Bảo mật Check-in QR Token (HMAC SHA-256 ký phiên QR quay vòng chống giả mạo)
CHECKIN_SECRET_KEY=super-secret-key-at-least-32-characters-long-hen-ca-phe

# 7. Scheduled Cron Secret (Bảo vệ API định kỳ đóng poll / check no-show)
CRON_SECRET=your-cron-secret-for-background-jobs
